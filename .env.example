DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kabul

# sqlite (default)
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

